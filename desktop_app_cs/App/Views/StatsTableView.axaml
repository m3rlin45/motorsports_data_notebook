<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfernoAnalyzer.App.Views.StatsTableView">
  <StackPanel Spacing="2">
    <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="12" Margin="0,6,0,2" />
    <Grid x:Name="TableGrid" />
  </StackPanel>
</UserControl>
