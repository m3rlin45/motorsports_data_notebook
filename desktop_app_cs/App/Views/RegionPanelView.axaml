<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfernoAnalyzer.App.ViewModels"
             xmlns:controls="using:InfernoAnalyzer.App.Controls"
             x:Class="InfernoAnalyzer.App.Views.RegionPanelView"
             x:DataType="vm:RegionsViewModel"
             IsVisible="{Binding HasSession}">
  <!--
    The sidebar's region selector, under the lap lists: file, then laps, then which part of the
    track. A row per corner and per sector, as the laps have theirs (tick or untick; double click:
    only this one); nothing ticked is whole laps. A corner's row says which way it turns and how
    slow it gets. The map underneath shows where they are. One choice for every tab; on a tab
    that does not use regions the rows are dimmed and a line says so. The card is as tall as
    its rows need when the sidebar has the room (MainWindow.ArrangeSidebar); otherwise the rows scroll.
  -->
  <Border Classes="card">
    <!-- Header on top, map at the bottom, and the list takes what is between: it is what scrolls when the sidebar is short. -->
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <Button x:Name="WholeLap" DockPanel.Dock="Right" Classes="chip" Classes.lit="{Binding !HasSelection}" Content="Whole lap"
                Command="{Binding ClearCommand}" IsEnabled="{Binding IsUsed}"
                ToolTip.Tip="Untick every region: whole laps" />
        <TextBlock Classes="title" Text="Regions" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="subtle" Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,4"
                 IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <controls:ChartHost x:Name="Map" DockPanel.Dock="Bottom" Height="132" Margin="0,6,0,0"
                          Spec="{Binding MapSpec}" HighlightedItem="{Binding HoveredRegion}" CursorGroup="{Binding Position}"
                          AutomationProperties.Name="Track map of the regions"
                          ToolTip.Tip="The ticked regions on the track, and where the cursor on the charts is; click a corner to tick it" />
      <TextBlock x:Name="UseCaption" DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding !IsUsed}" />
      <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding SectorsHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding SectorsHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ScrollViewer x:Name="Rows" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- The right margin is where the scroll bar appears, clear of the speeds. -->
        <StackPanel x:Name="RowsContent" IsEnabled="{Binding IsUsed}" Margin="0,0,10,0">
          <ItemsControl x:Name="CornerRows" ItemsSource="{Binding Corners}" AutomationProperties.Name="Corners">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegionItemViewModel">
                <CheckBox Classes="regionrow" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                  <Grid ColumnDefinitions="*,20,72">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding Direction}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="numeric subtle" Text="{Binding Speed}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="section" Text="Sectors" Margin="0,6,0,2" IsVisible="{Binding HasSectors}" />
          <ItemsControl x:Name="SectorRows" ItemsSource="{Binding Sectors}" AutomationProperties.Name="Sectors">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegionItemViewModel">
                <CheckBox Classes="regionrow" IsChecked="{Binding IsSelected}" Content="{Binding Name}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
