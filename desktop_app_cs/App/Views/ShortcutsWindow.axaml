<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfernoAnalyzer.App.Views.ShortcutsWindow"
        Title="Keyboard shortcuts" Width="460" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppPageBrush}">
  <DockPanel Margin="24">
    <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="88" Margin="0,16,0,0" />
    <StackPanel x:Name="Rows" Spacing="2" />
  </DockPanel>
</Window>
