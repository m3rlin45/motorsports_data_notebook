<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfernoAnalyzer.App.Views.UnsavedChangesDialog"
        Title="Unsaved changes" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppPageBrush}">
  <StackPanel Margin="24" Spacing="16" MaxWidth="420">
    <TextBlock x:Name="Message" Classes="title" TextWrapping="Wrap" />
    <TextBlock Classes="subtle" Text="Your gate and name edits will be lost if you don't save them." TextWrapping="Wrap" />
    <StackPanel x:Name="Buttons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="SaveButton" Classes="accent" Content="_Save" IsDefault="True" MinWidth="88" />
      <Button x:Name="DiscardButton" Content="_Don't save" MinWidth="88" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</Window>
