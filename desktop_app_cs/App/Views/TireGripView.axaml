<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfernoAnalyzer.App.ViewModels"
             xmlns:views="using:InfernoAnalyzer.App.Views"
             x:Class="InfernoAnalyzer.App.Views.TireGripView"
             x:DataType="vm:TireGripViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <ToggleButton DockPanel.Dock="Right" Content="Statistics" IsChecked="{Binding ShowStats}" Padding="8,2" FontSize="11" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
          <TextBlock Text="P:" FontSize="11" VerticalAlignment="Center" />
          <TextBox Text="{Binding Percentile}" Width="56" FontSize="11" MinHeight="24" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
          <RadioButton Content="Pressure" GroupName="tiremetric" IsChecked="{Binding IsPressure}" FontSize="11" />
          <RadioButton Content="Temperature" GroupName="tiremetric" IsChecked="{Binding IsTemperature}" FontSize="11" />
        </StackPanel>
        <TextBlock Text="Tire grip — percentile of total G per tire pressure or temperature bucket" VerticalAlignment="Center" FontSize="11" />
      </DockPanel>
    </Border>
    <ScrollViewer DockPanel.Dock="Right" Width="480" IsVisible="{Binding ShowStats}" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="6">
      <ItemsControl ItemsSource="{Binding Stats}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatsTable">
            <views:StatsTableView Table="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <ContentControl x:Name="ChartHost" />
  </DockPanel>
</UserControl>
