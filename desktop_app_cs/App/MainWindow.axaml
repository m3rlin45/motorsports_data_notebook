<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfernoAnalyzer.App.MainWindow"
        Title="Inferno Analyzer — strip chart spike"
        Width="1280" Height="860">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock x:Name="FixtureLabel" x:FieldModifier="public" VerticalAlignment="Center" />
        <TextBlock Text="X axis:" VerticalAlignment="Center" />
        <RadioButton x:Name="DistanceRadio" x:FieldModifier="public" Content="Distance" GroupName="xaxis" IsChecked="True" />
        <RadioButton x:Name="TimeRadio" x:FieldModifier="public" Content="Time" GroupName="xaxis" />
      </StackPanel>
    </Border>
    <ContentControl x:Name="ChartHost" />
  </DockPanel>
</Window>
