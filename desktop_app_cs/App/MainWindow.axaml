<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfernoAnalyzer.App.MainWindow"
        Title="Inferno Analyzer — strip chart spike"
        Width="1280" Height="860"
        Background="#1e1e1e">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" Background="#2a2a2a">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock x:Name="FixtureLabel" x:FieldModifier="public" VerticalAlignment="Center" Foreground="#d0d0d0" />
        <TextBlock Text="X axis:" VerticalAlignment="Center" Foreground="#d0d0d0" />
        <RadioButton x:Name="DistanceRadio" x:FieldModifier="public" Content="Distance" GroupName="xaxis" IsChecked="True" />
        <RadioButton x:Name="TimeRadio" x:FieldModifier="public" Content="Time" GroupName="xaxis" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="#2a2a2a">
      <TextBlock x:Name="Readout" x:FieldModifier="public" FontFamily="Consolas, Menlo, monospace" Foreground="#e8e8e8" />
    </Border>
    <ContentControl x:Name="ChartHost" />
  </DockPanel>
</Window>
