<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>InfernoAnalyzer</AssemblyName>
    <RootNamespace>InfernoAnalyzer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\inferno.ico</ApplicationIcon>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NativeAOT on Windows and Linux (CI); the Windows cross-build from Linux passes -p:PublishAot=false (see justfile). -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- The headless tests reach the named controls of the views. -->
  <ItemGroup>
    <InternalsVisibleTo Include="InfernoAnalyzer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\InfernoAnalyzer.Core.csproj" />
    <ProjectReference Include="..\Charting\InfernoAnalyzer.Charting.csproj" />
    <!-- The one place the backend is chosen (see ChartSurfaces.cs). -->
    <ProjectReference Include="..\Charting.ScottPlot\InfernoAnalyzer.Charting.ScottPlot.csproj" />
  </ItemGroup>

  <!-- Window icon and About image (regenerate with tools/make_icon.py). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
