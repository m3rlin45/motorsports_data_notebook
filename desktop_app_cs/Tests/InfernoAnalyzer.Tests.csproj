<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    xunit v3 (not v2 as in tire_pressure_calculator/Tests): Avalonia 12's
    Avalonia.Headless.XUnit is built on xunit.v3, and the two cannot coexist.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <!-- Real Skia drawing in headless tests, so render smoke tests produce actual PNGs. -->
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\InfernoAnalyzer.Core.csproj" />
    <ProjectReference Include="..\Charting\InfernoAnalyzer.Charting.csproj" />
    <ProjectReference Include="..\App\InfernoAnalyzer.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Python-parity fixtures (Phase 2) are copied next to the test DLL. -->
  <ItemGroup>
    <None Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
