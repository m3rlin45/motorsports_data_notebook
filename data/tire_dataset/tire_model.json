{
  "schema_version": 3,
  "fit_at_utc": "2026-08-28T01:37:51+00:00",
  "car_aliases": {
    "KK-F": "FJ",
    "KK-SII": "FJ"
  },
  "model_form": "T_hot - T_eff = K[car,corner,cond] * c_track[track] * g2 * (1 - exp(-t / tau_sec[car,corner,cond]))   where T_eff = (1-w_road)*T_air + w_road*T_road, t = N * lap_time_s, g2 = g2_typ[track,car,cond] * clamp((lap_time_typ_s / target_lap_time_s)^g2_lap_time_exponent) when a target lap time is given, else g2_typ",
  "g2_lap_time_model": {
    "method": "sector_knn_median_curve",
    "formula": "g2 = g2_typ * interp(target_lap_time_s, g2_vs_lap_time) / interp(lap_time_typ_s, g2_vs_lap_time); buckets without a curve fall back to g2_typ * (lap_time_typ_s / target_lap_time_s) ** default_exponent. The multiplier is clamped either way.",
    "default_exponent": 1.4875678451500864,
    "multiplier_clamp": {
      "min": 0.4,
      "max": 2.5
    }
  },
  "gay_lussac": {
    "p_atm_bar": 1.0,
    "t_zero_c_to_k": 273.15,
    "t_cold_uses": "T_air"
  },
  "energy_balance": {
    "w_road": 0.2,
    "w_road_fitted": false,
    "t_road_proxy": {
      "formula": "T_air + delta_sun_max_c * (1 - cloud_cover/100) * sun_factor",
      "delta_sun_max_c": 10.0,
      "sun_factor_default": 1.0
    }
  },
