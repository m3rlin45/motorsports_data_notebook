        "Inferno 86": 1.0247520442967407e-05
      },
      "fitted": true
    }
  },
  "rain_thermal": {
    "method": "tau/K fitted per condition; tau_rain <= tau_dry bounded inside the fit (rain only adds cooling), K free (a rain compound has its own hysteresis). Rain buckets with fewer sessions fall back to dry via the condition chain.",
    "min_sessions_for_rain_fit": 3
  },
